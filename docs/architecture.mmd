flowchart TB
    Client["客户端"]
    SLOT["并发闸 TurnSlot<br/>抢槽 / 幂等 / 409"]

    subgraph S1["① 上下文构建"]
        direction LR
        LOAD["装载候选（executor）<br/>会话历史 / 学习状态 / 材料候选"]
        POOL["候选池"]
        LOAD --> POOL
    end

    subgraph S2["② 策略选择"]
        direction LR
        PLAN["Planner<br/>池内选择与组装"]
        FB{"plan 异常?"}
        DEF["回退 default（explain-first）"]
        PLAN --> FB
        FB -->|是| DEF
    end

    subgraph S3["③ 模型与工具调用"]
        direction LR
        MODEL["执行器：调用模型<br/>流式生成"]
        TOOL["工具执行"]
        MODEL -->|tool_call| TOOL
        TOOL -->|结果回填| MODEL
    end

    subgraph S5["⑤ 流式响应"]
        direction LR
        CH["增量通道<br/>publish / subscribe"]
        CH --> SSE["SSE 推送"]
    end

    subgraph S4["④ 数据持久化"]
        DB[("SQLite WAL")]
    end

    Client -->|HTTP| SLOT
    SLOT --> LOAD
    POOL -->|PlanInput| PLAN
    FB -->|否 · TurnPlan| MODEL
    DEF -->|TurnPlan| MODEL
    MODEL -->|增量| CH
    SSE -->|SSE| Client
    LOAD -. 读 .-> DB
    MODEL -. fenced 写 .-> DB
